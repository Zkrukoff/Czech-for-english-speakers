  "dialogue": {
    "setting": "A tourist stops a woman in the street in Olomouc.",
    "lines": [
      {
        "speaker": "Turista",
        "cs": "Promiňte, kde je tady nejbližší [[lékárna|lékárna|nom|subject]]?",
        "en": "Excuse me, where's the nearest pharmacy?",
        "nativeReviewed": false
      },
      {
        "speaker": "Paní",
        "cs": "Lékárna? Jděte rovně a pak doleva.",
        "en": "A pharmacy? Go straight on and then left.",
        "nativeReviewed": false
      },
      {
        "speaker": "Turista",
        "cs": "Je to daleko?",
        "en": "Is it far?",
        "nativeReviewed": false
      },
      {
        "speaker": "Paní",
        "cs": "Ne, je to asi pět [[minut|minuta|gen.pl|quantity-5plus]] pěšky. Je to vedle [[banky|banka|gen|after-vedle]].",
        "en": "No, it's about five minutes' walk. It's next to the bank.",
        "nativeReviewed": false
      },
      {
        "speaker": "Turista",
        "cs": "Děkuju moc.",
        "en": "Thank you very much.",
        "nativeReviewed": false
      },
      {
        "speaker": "Paní",
        "cs": "Není zač.",
        "en": "You're welcome.",
        "nativeReviewed": false
      }
    ]
  },
