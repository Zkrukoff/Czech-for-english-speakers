      "id": "u03-l01-e1",
      "type": "translate",
      "direction": "en-cs",
      "prompt": "Excuse me, where is the station?",
      "answers": [
        "Promiňte, kde je [tady ]nádraží?"
      ],
      "why": "Promiňte is the polite \"excuse me\"; Kde je…? = Where is…? nádraží doesn't change.",
      "hints": [
        {
          "wrong": "Promiň, kde je [tady ]nádraží?",
          "explain": "Promiň is informal (ty). To a stranger, say Promiňte."
        }
