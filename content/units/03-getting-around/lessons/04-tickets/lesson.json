  "dialogue": {
    "setting": "At the ticket office of Prague main station.",
    "lines": [
      {
        "speaker": "Cestující",
        "cs": "Dobrý den, jednu jízdenku do Brna, prosím.",
        "en": "Hello, one ticket to Brno, please.",
        "nativeReviewed": false
      },
      {
        "speaker": "Pokladní",
        "cs": "Jednosměrnou, nebo zpáteční?",
        "en": "Single or return?",
        "nativeReviewed": false
      },
      {
        "speaker": "Cestující",
        "cs": "Zpáteční. V kolik jede nejbližší vlak?",
        "en": "Return. What time is the next train?",
        "nativeReviewed": false
      },
      {
        "speaker": "Pokladní",
        "cs": "V půl jedenácté, z nástupiště číslo pět.",
        "en": "At half past ten, from platform number five.",
        "nativeReviewed": false
      },
      {
        "speaker": "Cestující",
        "cs": "Musím přestupovat?",
        "en": "Do I have to change?",
        "nativeReviewed": false
      },
      {
        "speaker": "Pokladní",
        "cs": "Ne, ten jede přímo. Platíte kartou?",
        "en": "No, it goes direct. Are you paying by card?",
        "nativeReviewed": false
      },
      {
        "speaker": "Cestující",
        "cs": "Ano.",
        "en": "Yes.",
        "nativeReviewed": false
      },
      {
        "speaker": "Pokladní",
        "cs": "Tady to máte. Šťastnou cestu!",
        "en": "Here you are. Have a good trip!",
        "nativeReviewed": false
      }
    ]
  },
  "exercises": [
    {
      "id": "u03-l04-e1",
      "type": "translate",
      "direction": "en-cs",
      "prompt": "One ticket to Prague, please.",
      "answers": [
        "{Jednu jízdenku|Jeden lístek} do Prahy[, prosím]."
      ],
      "why": "The ticket is the object of an implied \"I'd like\", so it's in the accusative: jedna jízdenka → jednu jízdenku. do takes the genitive: do Prahy.",
      "hints": [
        {
          "wrong": "Jedna jízdenka do Prahy[, prosím].",
          "explain": "You're asking for a ticket (the object), so use the accusative: jednu jízdenku."
        },
        {
          "wrong": "{Jednu jízdenku|Jeden lístek} do Praha[, prosím].",
          "explain": "do takes the genitive: Praha → do Prahy."
        }
      ],
      "skills": [
        "case:accusative",
        "case:genitive",
        "vocab:v-jizdenka"
      ],
      "nativeReviewed": false
    },
