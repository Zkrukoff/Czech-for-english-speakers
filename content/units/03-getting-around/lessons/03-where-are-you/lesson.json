  "dialogue": {
    "setting": "After work, Ondřej is waiting for his colleague Klára and calls her.",
    "lines": [
      {
        "speaker": "Ondřej",
        "cs": "Ahoj, kde jsi? Já už jsem na [[místě|místo|loc|location-v-na]].",
        "en": "Hi, where are you? I'm already there.",
        "spoken": {
          "form": "Ahoj, kde seš? Já už sem na místě.",
          "note": "seš and sem for jsi and jsem."
        },
        "nativeReviewed": false
      },
      {
        "speaker": "Klára",
        "cs": "Promiň, jsem ještě v [[tramvaji|tramvaj|loc|location-v-na]]. Budu tam za deset [[minut|minuta|gen.pl|quantity-5plus]].",
        "en": "Sorry, I'm still on the tram. I'll be there in ten minutes.",
        "nativeReviewed": false
      },
      {
        "speaker": "Ondřej",
        "cs": "Dobře. Čekám v [[kavárně|kavárna|loc|location-v-na]] na [[náměstí|náměstí|loc|location-v-na]].",
        "en": "OK. I'm waiting in the café on the square.",
        "nativeReviewed": false
      },
      {
        "speaker": "Klára",
        "cs": "V té [[kavárně|kavárna|loc|location-v-na]] vedle [[muzea|muzeum|gen|after-vedle]]?",
        "en": "In the café next to the museum?",
        "nativeReviewed": false
      },
      {
        "speaker": "Ondřej",
        "cs": "Ano, sedím venku.",
        "en": "Yes, I'm sitting outside.",
        "spoken": {
          "form": "Jo, sedím venku.",
          "note": "jo = ano"
        },
        "nativeReviewed": false
      },
      {
        "speaker": "Klára",
        "cs": "Super, za chvíli jsem tam.",
        "en": "Great, I'll be there in a moment.",
        "nativeReviewed": false
      }
    ]
  },
