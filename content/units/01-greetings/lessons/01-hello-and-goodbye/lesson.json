  "dialogue": {
    "setting": "Monday morning at the entrance of an office building in Prague. Daniel, who moved from England last month, meets his colleague Jana and their manager.",
    "lines": [
      {
        "speaker": "Daniel",
        "cs": "Ahoj, [[Jano|Jana|voc|addressing]]!",
        "en": "Hi, Jana!",
        "nativeReviewed": false
      },
      {
        "speaker": "Jana",
        "cs": "Ahoj, [[Danieli|Daniel|voc|addressing]]! Jak se máš?",
        "en": "Hi, Daniel! How are you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Daniel",
        "cs": "Dobře, díky. A ty?",
        "en": "Fine, thanks. And you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Jana",
        "cs": "Ujde to.",
        "en": "Not bad. / It's OK.",
        "nativeReviewed": false
      },
      {
        "speaker": "Daniel",
        "cs": "Dobrý den, paní Dvořáková.",
        "en": "Good morning, Mrs Dvořáková.",
        "nativeReviewed": false
      },
      {
        "speaker": "Paní Dvořáková",
        "cs": "Dobrý den, [[Danieli|Daniel|voc|addressing]]. Jak se máte?",
        "en": "Good morning, Daniel. How are you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Daniel",
        "cs": "Děkuju, dobře. A vy?",
        "en": "Fine, thank you. And you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Paní Dvořáková",
        "cs": "Taky dobře, děkuju.",
        "en": "Fine too, thank you.",
        "nativeReviewed": false
      },
      {
        "speaker": "Jana",
        "cs": "Tak čau, [[Danieli|Daniel|voc|addressing]]. Měj se!",
        "en": "Right, bye, Daniel. Take care!",
        "nativeReviewed": false
      },
      {
        "speaker": "Daniel",
        "cs": "Ty taky. Čau!",
        "en": "You too. Bye!",
        "nativeReviewed": false
      }
    ]
  },
