  "dialogue": {
    "setting": "Saturday morning in Lucie's neighbourhood. She meets her neighbour, then Petr, a colleague who lives nearby.",
    "lines": [
      {
        "speaker": "Lucie",
        "cs": "Dobrý den, [[pane|pan|voc|addressing]] [[Nováku|Novák|voc|addressing]]!",
        "en": "Good morning, Mr Novák!",
        "nativeReviewed": false
      },
      {
        "speaker": "Pan Novák",
        "cs": "Dobrý den, [[Lucie|Lucie|voc|addressing]]. Jak se máte?",
        "en": "Good morning, Lucie. How are you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Lucie",
        "cs": "Děkuju, dobře. A vy?",
        "en": "Fine, thanks. And you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Pan Novák",
        "cs": "Docela dobře, děkuju. Hezký den!",
        "en": "Pretty good, thanks. Have a nice day!",
        "nativeReviewed": false
      },
      {
        "speaker": "Lucie",
        "cs": "Vám taky!",
        "en": "You too!",
        "nativeReviewed": false
      },
      {
        "speaker": "Petr",
        "cs": "Lucie! Ahoj!",
        "en": "Lucie! Hi!",
        "nativeReviewed": false
      },
      {
        "speaker": "Lucie",
        "cs": "Ahoj, [[Petře|Petr|voc|addressing]]! Kam jdeš?",
        "en": "Hi, Petr! Where are you going?",
        "nativeReviewed": false
      },
      {
        "speaker": "Petr",
        "cs": "Na [[trh|trh|acc|after-na-motion]]. A ty?",
        "en": "To the market. And you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Lucie",
        "cs": "Já taky. Půjdeme spolu?",
        "en": "Me too. Shall we go together?",
        "nativeReviewed": false
      },
      {
        "speaker": "Petr",
        "cs": "Jasně, pojď.",
        "en": "Sure, come on.",
        "nativeReviewed": false
      }
    ]
  },
