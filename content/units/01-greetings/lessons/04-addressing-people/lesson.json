    {
      "id": "u01-l04-e1",
      "type": "translate",
      "direction": "en-cs",
      "prompt": "Hi, Petr!",
      "answers": [
        "{Ahoj|Čau}[,] Petře[!]"
      ],
      "why": "When you speak to someone, their name goes in the vocative. Names ending in a consonant + r change it to -ře: Petr → Petře.",
      "hints": [
        {
          "wrong": "{Ahoj|Čau}[,] Petr[!]",
          "explain": "You're speaking to Petr, so use the vocative: Petr → Petře."
        },
        {
          "wrong": "{Ahoj|Čau}[,] Petre[!]",
          "explain": "Close! After a consonant, -r becomes -ře: Petře."
        }
      ],
      "skills": [
        "case:vocative"
      ],
      "nativeReviewed": false
    },
