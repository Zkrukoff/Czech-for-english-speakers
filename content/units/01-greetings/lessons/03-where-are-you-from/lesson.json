  "dialogue": {
    "setting": "At a friend's birthday party, Sam meets Petra.",
    "lines": [
      {
        "speaker": "Petra",
        "cs": "Odkud jsi?",
        "en": "Where are you from?",
        "nativeReviewed": false
      },
      {
        "speaker": "Sam",
        "cs": "Jsem z Anglie, z Manchesteru. A ty? Jsi z Prahy?",
        "en": "I'm from England, from Manchester. And you? Are you from Prague?",
        "nativeReviewed": false
      },
      {
        "speaker": "Petra",
        "cs": "Ne, jsem z Brna, ale bydlím v Praze.",
        "en": "No, I'm from Brno, but I live in Prague.",
        "nativeReviewed": false
      },
      {
        "speaker": "Sam",
        "cs": "A co děláš?",
        "en": "And what do you do?",
        "nativeReviewed": false
      },
      {
        "speaker": "Petra",
        "cs": "Jsem učitelka. Učím angličtinu. A ty?",
        "en": "I'm a teacher. I teach English. And you?",
        "nativeReviewed": false
      },
      {
        "speaker": "Sam",
        "cs": "Já jsem programátor. Pracuju z domu.",
        "en": "I'm a programmer. I work from home.",
        "nativeReviewed": false
      },
      {
        "speaker": "Petra",
        "cs": "To zní dobře.",
        "en": "That sounds good.",
        "nativeReviewed": false
      }
    ]
  },
  "exercises": [
    {
      "id": "u01-l03-e1",
      "type": "fillEnding",
      "prompt": "Jsem z Kanad___.",
      "base": "Kanada",
      "en": "I'm from Canada.",
      "answers": [
        "y"
      ],
      "why": "z (from) takes the genitive. Feminine nouns in -a change it to -y: Kanada → z Kanady, Praha → z Prahy.",
      "hints": [
        {
          "wrong": "a",
          "explain": "Kanada is the nominative (dictionary form). After z, use the genitive: z Kanady."
        }
      ],
      "skills": [
        "case:genitive"
      ],
      "nativeReviewed": false
    },
    {
