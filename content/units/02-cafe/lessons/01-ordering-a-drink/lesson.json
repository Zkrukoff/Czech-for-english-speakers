    {
      "id": "u02-l01-e1",
      "type": "fillEnding",
      "prompt": "Dám si káv___, prosím.",
      "base": "káva",
      "en": "I'll have a coffee, please.",
      "answers": [
        "u"
      ],
      "why": "The thing you order is the direct object of 'dát si', so it takes the accusative. Feminine nouns ending in -a change it to -u: káva → kávu.",
      "hints": [
        {
          "wrong": "a",
          "explain": "'káva' is the nominative (dictionary) form. As the object of 'dát si' it needs the accusative: kávu."
