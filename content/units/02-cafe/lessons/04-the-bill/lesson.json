  "dialogue": {
    "setting": "The end of lunch with a colleague.",
    "lines": [
      {
        "speaker": "Tom",
        "cs": "Pane vrchní, zaplatíme, prosím.",
        "en": "Excuse me, we'd like to pay, please.",
        "nativeReviewed": false
      },
      {
        "speaker": "Číšník",
        "cs": "Dohromady, nebo zvlášť?",
        "en": "Together or separately?",
        "nativeReviewed": false
      },
      {
        "speaker": "Tom",
        "cs": "Dohromady.",
        "en": "Together.",
        "nativeReviewed": false
      },
      {
        "speaker": "Číšník",
        "cs": "Chutnalo vám?",
        "en": "Did you enjoy your meal?",
        "nativeReviewed": false
      },
      {
        "speaker": "Anna",
        "cs": "Ano, bylo to výborné.",
        "en": "Yes, it was excellent.",
        "nativeReviewed": false
      },
      {
        "speaker": "Číšník",
        "cs": "Takže dvakrát pivo, polévka, smažený sýr a guláš. To bude čtyři sta šedesát [[korun|koruna|gen.pl|quantity-5plus]].",
        "en": "So two beers, a soup, fried cheese and goulash. That'll be four hundred and sixty crowns.",
        "nativeReviewed": false
      },
      {
        "speaker": "Tom",
        "cs": "Tady máte pět set, to je v pořádku.",
        "en": "Here's five hundred, keep the change.",
        "spoken": {
          "form": "Pět set, to je dobrý.",
          "note": "\"To je dobrý\" (standard: to je dobré) is how people very often say \"keep the change\"."
        },
        "nativeReviewed": false
      },
      {
        "speaker": "Číšník",
        "cs": "Děkuju. Hezký večer!",
        "en": "Thank you. Have a nice evening!",
        "nativeReviewed": false
      },
      {
        "speaker": "Anna",
        "cs": "Vám taky. Na shledanou.",
        "en": "You too. Goodbye.",
        "nativeReviewed": false
      }
    ]
  },
