  "dialogue": {
    "setting": "Friday lunch. Sarah's friend Kateřina asks about her new job.",
    "lines": [
      {
        "speaker": "Kateřina",
        "cs": "Tak co, jak se ti líbí nová práce?",
        "en": "So, how do you like the new job?",
        "nativeReviewed": false
      },
      {
        "speaker": "Sarah",
        "cs": "Moc. Kolegové jsou milí a pomáhají mi s češtinou.",
        "en": "A lot. My colleagues are nice and they help me with my Czech.",
        "nativeReviewed": false
      },
      {
        "speaker": "Kateřina",
        "cs": "A jaký je tvůj šéf?",
        "en": "And what's your boss like?",
        "nativeReviewed": false
      },
      {
        "speaker": "Sarah",
        "cs": "Je trochu přísný, ale spravedlivý. A je velmi pracovitý.",
        "en": "He's a bit strict, but fair. And he's very hard-working.",
        "nativeReviewed": false
      },
      {
        "speaker": "Kateřina",
        "cs": "To zní dobře. Můj šéf je strašně náročný.",
        "en": "That sounds good. My boss is terribly demanding.",
        "spoken": {
          "form": "strašně",
          "note": "strašně (terribly) is a very common everyday intensifier, for good things too: strašně milý."
        },
        "nativeReviewed": false
      },
      {
        "speaker": "Sarah",
        "cs": "To mě mrzí.",
        "en": "I'm sorry to hear that.",
        "nativeReviewed": false
      }
    ]
