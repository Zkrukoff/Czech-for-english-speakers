      "prompt": "Moji kolegové jsou mil___.",
      "base": "milý",
      "en": "My colleagues are nice.",
      "answers": [
        "í"
      ],
      "why": "For groups of people with at least one man (masculine animate plural), adjectives end in -í: milí kolegové.",
      "hints": [
        {
          "wrong": "é",
          "explain": "-é is the plural for women and things: milé kolegyně. Kolegové (men, or a mixed group) take -í: milí."
        },
        {
          "wrong": "ý",
          "explain": "kolegové is plural, so the adjective is plural: milí."
        }
      ],
      "skills": [
