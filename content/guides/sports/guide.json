      "id": "watching",
      "title": "Watching a game",
      "phrases": [
        {
          "cs": "Kolik je?",
          "en": "What's the score?",
          "nativeReviewed": false
        },
        {
          "cs": "Dva jedna pro Spartu.",
          "en": "Two–one to Sparta.",
          "nativeReviewed": false
        },
        {
          "cs": "Nula nula.",
          "en": "Nil–nil.",
          "nativeReviewed": false
        },
        {
          "cs": "Gól!",
          "en": "Goal!",
          "nativeReviewed": false
        },
        {
          "cs": "To byl faul!",
          "en": "That was a foul!",
          "nativeReviewed": false
        },
        {
          "cs": "Rozhodčí!",
          "en": "Ref!",
          "nativeReviewed": false,
          "note": "Shouted, in a tone that finishes the sentence for you."
        },
        {
          "cs": "Jdou do prodloužení.",
          "en": "It's going to overtime.",
          "nativeReviewed": false
        },
        {
          "cs": "Budou nájezdy.",
          "en": "It's going to a shootout.",
          "nativeReviewed": false,
          "note": "Hockey: nájezdy are the penalty shots after overtime."
        }
      ]
    },
    {
      "id": "talking",
      "title": "Talking about it",
      "phrases": [
        {
          "cs": "Komu fandíš?",
          "en": "Who do you support?",
          "nativeReviewed": false,
          "note": "fandit + dative: komu?"
        },
        {
          "cs": "Fandím Slavii.",
          "en": "I support Slavia.",
          "nativeReviewed": false
        },
        {
          "cs": "Fandím Spartě.",
          "en": "I support Sparta.",
          "nativeReviewed": false
        },
        {
          "cs": "Jdeme na hokej.",
          "en": "We're going to the hockey.",
          "nativeReviewed": false,
          "note": "na + accusative for events: na hokej, na fotbal, na zápas."
        },
        {
          "cs": "Viděl jsi včera ten zápas?",
          "en": "Did you see the game yesterday?",
          "nativeReviewed": false,
          "note": "To a woman: Viděla jsi…"
        },
        {
          "cs": "Vyhráli jsme!",
          "en": "We won!",
          "nativeReviewed": false
        },
        {
          "cs": "Prohráli jsme.",
          "en": "We lost.",
          "nativeReviewed": false
        },
        {
          "cs": "Byla to remíza.",
          "en": "It was a draw.",
          "nativeReviewed": false
        }
      ]
    }
