  "practice": [
    {
      "id": "sports-basics",
      "title": "At the game",
      "description": "Scores, who you support, and getting a ticket.",
      "exercises": [
        {
          "id": "spo-x1",
          "type": "translate",
          "direction": "en-cs",
          "prompt": "Who do you support?",
          "answers": [
            "Komu fandíš[?]",
            "Komu fandíte[?]"
          ],
          "why": "fandit takes the dative (komu?), so the question word is komu, not koho.",
          "hints": [],
          "skills": [
            "guide:sports"
          ],
          "nativeReviewed": false
        },
        {
          "id": "spo-x2",
          "type": "translate",
          "direction": "en-cs",
          "prompt": "We're going to the hockey.",
          "answers": [
            "Jdeme na hokej[.]",
            "Jedeme na hokej[.]"
          ],
          "why": "na + accusative for events you go to: na hokej, na fotbal.",
          "hints": [],
          "skills": [
            "guide:sports"
          ],
          "nativeReviewed": false
        },
        {
          "id": "spo-x3",
          "type": "multipleChoice",
          "prompt": "\"I support Slavia.\" Which form of Slavia?",
          "options": [
            "Fandím Slavii.",
            "Fandím Slavia.",
            "Fandím Slavie."
          ],
          "optionsLang": "cs",
          "answers": [
            "Fandím Slavii."
          ],
          "hints": [
            {
              "wrong": "Fandím Slavia.",
              "explain": "Slavia is the dictionary form (1st case). fandit needs the 3rd case (dative): Slavii."
            },
            {
              "wrong": "Fandím Slavie.",
              "explain": "Slavie is the 2nd case (genitive), as in \"fanoušci Slavie\". After fandit you need the dative: Slavii."
            }
          ],
          "why": "fandit + dative (komu?). Slavia → Slavii, like růže → růži.",
          "skills": [
            "guide:sports"
          ],
          "nativeReviewed": false
        },
        {
          "id": "spo-x4",
          "type": "multipleChoice",
          "prompt": "What do fans mean by \"Kdo neskáče, není Čech!\"?",
          "options": [
            "Everyone jump: you're not Czech if you don't.",
            "Nobody jump: Czechs stay seated.",
            "Who's the Czech who isn't jumping?"
          ],
          "optionsLang": "cs",
          "answers": [
            "Everyone jump: you're not Czech if you don't."
          ],
          "hints": [
            {
              "wrong": "Nobody jump: Czechs stay seated.",
              "explain": "It's the opposite: \"whoever doesn't jump isn't Czech\", so everybody jumps."
            },
            {
              "wrong": "Who's the Czech who isn't jumping?",
              "explain": "kdo here means \"whoever\", not \"who?\": whoever isn't jumping isn't Czech."
            }
          ],
          "why": "kdo… není… = whoever… isn't…. Then: hop, hop, hop!",
          "skills": [
            "guide:sports"
          ],
          "nativeReviewed": false
        },
        {
          "id": "spo-x5",
          "type": "multipleChoice",
          "prompt": "Your colleague says \"Bylo to dva dva.\" What happened?",
          "options": [
            "It was a draw, 2–2.",
            "We won 2–0.",
            "It was two games."
          ],
          "optionsLang": "cs",
          "answers": [
            "It was a draw, 2–2."
          ],
          "hints": [
            {
              "wrong": "We won 2–0.",
              "explain": "Nil is nula: 2–0 would be \"dva nula\". Dva dva is two–two."
            },
            {
              "wrong": "It was two games.",
              "explain": "Scores are read as two numbers: dva dva = 2–2."
            }
          ],
          "why": "Scores are just the two numbers: dva jedna (2–1), nula nula (0–0).",
          "skills": [
            "guide:sports"
          ],
          "nativeReviewed": false
        },
        {
          "id": "spo-x6",
          "type": "translate",
          "direction": "cs-en",
          "prompt": "Dvě vstupenky na sobotu, prosím.",
          "answers": [
            "Two tickets for Saturday[,] please[.]",
            "Two tickets for Saturday[.]"
          ],
          "why": "na + accusative for the day it's for: na sobotu.",
          "hints": [],
          "skills": [
            "guide:sports"
          ],
          "nativeReviewed": false
        }
      ]
    }
  ],
