  "practice": [
    {
      "id": "settle-say",
      "title": "Say it",
      "description": "The sentences you need on the phone, at the counter and at the doctor's.",
      "exercises": [
        {
          "id": "st-1",
          "type": "translate",
          "direction": "en-cs",
          "prompt": "The heating isn't working.",
          "answers": [
            "Nejde topení[.]",
            "Topení nejde[.]"
          ],
          "why": "Nejde (literally \"doesn't go\") is how Czech says something isn't working: Nejde topení.",
          "hints": [],
          "skills": [
            "guide:settling-in"
          ],
          "nativeReviewed": false
        },
        {
          "id": "st-2",
          "type": "translate",
          "direction": "en-cs",
          "prompt": "Could you write it down for me? (formal)",
          "answers": [
            "Můžete mi to napsat?",
            "Mohl{|a} byste mi to napsat?"
          ],
          "why": "Můžete mi to napsat? Polite vy form, with mi (for me).",
          "hints": [],
          "skills": [
            "guide:settling-in"
          ],
          "nativeReviewed": false
        },
        {
          "id": "st-3",
          "type": "translate",
          "direction": "en-cs",
          "prompt": "I have a sore throat.",
          "answers": [
            "Bolí mě v krku[.]"
          ],
          "why": "Czech says \"it hurts me in the throat\": Bolí mě v krku.",
          "hints": [],
          "skills": [
            "guide:settling-in"
          ],
          "nativeReviewed": false
        },
        {
          "id": "st-4",
          "type": "translate",
          "direction": "cs-en",
          "prompt": "Jaké doklady potřebuju?",
          "answers": [
            "{What|Which} documents do I need?"
          ],
          "why": "Doklady are documents (ID, certificates); potřebuju is I need.",
          "hints": [],
          "skills": [
            "guide:settling-in"
          ],
          "nativeReviewed": false
        },
        {
          "id": "st-5",
          "type": "multipleChoice",
          "prompt": "A flat advert says **3+kk**. What does it mean?",
          "options": [
            "3 rooms, with a kitchenette in one of them",
            "3 rooms plus a separate kitchen",
            "3 bedrooms plus a living room"
          ],
          "optionsLang": "en",
          "answers": [
            "3 rooms, with a kitchenette in one of them"
          ],
          "hints": [
            {
              "wrong": "3 rooms plus a separate kitchen",
              "explain": "That's 3+1: the +1 is a separate kitchen. kk is kuchyňský kout, a kitchenette."
            },
            {
              "wrong": "3 bedrooms plus a living room",
              "explain": "The number counts every room, the living room included: 3+kk is three rooms in all."
            }
          ],
          "why": "3+kk: three rooms, with a kitchenette (kk) in one of them, so no separate kitchen. 3+1 would have a separate kitchen.",
          "skills": [
            "guide:settling-in"
          ],
          "nativeReviewed": false
        }
      ]
    }
  ],
