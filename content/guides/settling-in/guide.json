  "phrasebook": [
    {
      "id": "settle-flat",
      "title": "The flat",
      "phrases": [
        {
          "cs": "Volám kvůli inzerátu na byt.",
          "en": "I'm calling about the flat advert.",
          "nativeReviewed": false
        },
        {
          "cs": "Kolik je nájem včetně poplatků?",
          "en": "How much is the rent including charges?",
          "nativeReviewed": false
        },
        {
          "cs": "Nejde topení.",
          "en": "The heating isn't working.",
          "nativeReviewed": false
        }
      ]
    },
    {
      "id": "settle-office",
      "title": "Offices",
      "phrases": [
        {
          "cs": "Mám objednaný termín na deset.",
          "en": "I have an appointment at ten.",
          "nativeReviewed": false
        },
        {
          "cs": "Jaké doklady potřebuju?",
          "en": "Which documents do I need?",
          "nativeReviewed": false
        },
        {
          "cs": "Můžete mi to napsat?",
          "en": "Could you write it down for me?",
          "nativeReviewed": false
        }
      ]
    },
    {
      "id": "settle-health",
      "title": "Doctor and pharmacy",
      "phrases": [
        {
          "cs": "Potřebuju se objednat k lékaři.",
          "en": "I need to make a doctor's appointment.",
          "nativeReviewed": false
        },
        {
          "cs": "Bolí mě v krku.",
          "en": "I have a sore throat.",
          "nativeReviewed": false
        },
        {
          "cs": "Máte něco na kašel?",
          "en": "Do you have anything for a cough?",
          "nativeReviewed": false
        }
      ]
